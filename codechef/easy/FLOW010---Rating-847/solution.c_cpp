#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin >> T;
	while (T--){
	    char id;
	    cin >> id;
	    if (id == 'B' || id == 'b')
	        cout << "Battleship" << endl;
	    else if (id == 'C' || id == 'c')
	        cout << "Cruiser" << endl;
	    else if (id == 'D' || id == 'd')
	        cout << "Destroyer" << endl;
	    else if (id == 'F' || id == 'f')
	        cout << "Frigate" << endl;
	}
	return 0;
}