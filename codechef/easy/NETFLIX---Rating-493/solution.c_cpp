#include <bits/stdc++.h>
using namespace std;

void solve(){
    int a, b, c, x;
    cin >> a >> b >> c >> x;
    if ((a + b >= x) || (b + c >= x) || (a + c >= x)) cout << "yes" << endl;
    else cout << "no" << endl;
}

int main() {
    int t;
    cin >> t;
    while (t--){
        solve();
    }
    return 0;
}
