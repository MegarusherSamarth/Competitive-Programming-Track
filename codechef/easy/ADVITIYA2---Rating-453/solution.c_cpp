#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--){
        int arr[5];
        int count_1 = 0;
        for(int i = 0; i < 5; i++){
            cin >> arr[i];
            if (arr[i] == 1) count_1++;
        }
        if (count_1 >= 4) cout << "Yes" << endl;
        else cout << "No" << endl;
    }
    return 0;
}
