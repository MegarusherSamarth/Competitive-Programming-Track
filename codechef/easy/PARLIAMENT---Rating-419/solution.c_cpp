#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
	while (t--){
	    int N, X;
	    cin >> N >> X;
	    if (N % 2 ==0){
	        if (X >= N / 2){
	            cout << "Yes" << endl;
	        } else {
	            cout << "No" << endl;
	        }
	    } else {
	        if (X >= (N/2)+1){
	            cout << "Yes" << endl;
	        } else {
	            cout << "No" << endl;
	        }
	    }
	}
	return 0;
}
