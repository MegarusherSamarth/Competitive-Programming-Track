#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        int sum = 0;
        vector<int> score(n);
        int c0 = 0; 
        for (int i = 0; i < n; i++){
            cin >> score[i];
            if (score[i] <= 4) c0++;
        }
        if (c0 == 0) cout << "yes" << endl;
        else cout << "no" << endl;
        
    }
    return 0;
}
